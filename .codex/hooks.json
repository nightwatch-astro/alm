{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $(git rev-parse --show-toplevel)/.codex/hooks/speckit-dag-hooks/scripts/dispatcher.py $(git rev-parse --show-toplevel)/.codex/hooks/speckit-dag-hooks/scripts/nodes.json pre",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/speckit/scripts/speckit-deferred-issues.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && uv run --quiet --script .codex/hooks/orchestrate/scripts/orchestrator-run-activate.py",
            "statusMessage": "Activating orchestrate run enforcement...",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $(git rev-parse --show-toplevel)/.codex/hooks/speckit-dag-hooks/scripts/dispatcher.py $(git rev-parse --show-toplevel)/.codex/hooks/speckit-dag-hooks/scripts/nodes.json pre",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/code-intelligence/scripts/code-discovery-steer.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/agent-coder/scripts/coder-delegation-reminder.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/beads/scripts/beads-gh-issue-guard.py",
            "statusMessage": "Checking gh issue command against beads policy...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".codex/hooks/beads/scripts/pr-merge-bead-guard.py",
            "statusMessage": "Checking the merge bead for this branch...",
            "timeout": 40
          },
          {
            "type": "command",
            "command": ".codex/hooks/beads/scripts/beads-sync-stage.py",
            "statusMessage": "Staging beads JSONL for commit...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && uv run --quiet --script .codex/hooks/orchestrate/scripts/orchestrator-claim-deny.py",
            "statusMessage": "Checking orchestrator claim policy...",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|send_message|followup_task|send_input|multi_agent_v1send_input",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && uv run --quiet --script .codex/hooks/orchestrate/scripts/orchestrator-activation-guard.py",
            "statusMessage": "Checking claim-holder activation sequence...",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/release-please/scripts/release-please-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/speckit-conductor/scripts/speckit-pr-title.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|Bash|Skill",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/speckit-conductor/scripts/speckit-tasks-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/adr-as-beads/scripts/adr-write-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hooks-worktrunk/scripts/worktrunk-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hooks-worktrunk/scripts/worktrunk-agent-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|send_message|followup_task|send_input|multi_agent_v1send_input|resume_agent|multi_agent_v1resume_agent",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .codex/hooks/worktrunk-writer/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .codex/hooks/worktrunk-writer/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/steering-git-workflow/scripts/pr-create-guard.py",
            "statusMessage": "Checking draft PR policy...",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $(git rev-parse --show-toplevel)/.codex/hooks/speckit-dag-hooks/scripts/dispatcher.py $(git rev-parse --show-toplevel)/.codex/hooks/speckit-dag-hooks/scripts/nodes.json post",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/code-intelligence/scripts/reindex-after-commit.sh",
            "if": "Bash(git commit*)",
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/speckit/scripts/speckit-task-commit-check.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/speckit/scripts/speckit-task-issue-sync.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hooks-quality/scripts/quality-edit-advisory.py",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/code-intelligence/scripts/codebase-index.sh",
            "async": true,
            "statusMessage": "Indexing codebase..."
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/beads/scripts/beads-sync-session.py",
            "statusMessage": "Syncing beads (Dolt pull, JSONL fallback)...",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/hooks-worktrunk/scripts/worktrunk-sweep.py",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/beads/scripts/beads-subagent-reminder.py",
            "statusMessage": "Injecting beads work contract...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && uv run --quiet --script .codex/hooks/orchestrate/scripts/contract-start.py",
            "statusMessage": "Injecting bead-as-brief claim contract...",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/steering-pragmatic/scripts/inject-working-style.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/code-intelligence/scripts/subagent-context-inject.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .codex/hooks/worktrunk-writer/.apm/skills/worktrunk-writer/scripts/context-handshake.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/speckit/scripts/speckit-stop-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/beads/scripts/beads-sync-push.py",
            "statusMessage": "Publishing beads state...",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && RULES_DIR=\"$(dirname \".codex/hooks/orchestrate/.apm/rules/generic.rules.json\")\" uv run --quiet --script .codex/hooks/orchestrate/scripts/rules-eval.py",
            "statusMessage": "Evaluating bead contract...",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
