{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Checking gh issue command against beads policy...",
          "command": ".claude/hooks/beads/scripts/beads-gh-issue-guard.py"
        },
        {
          "type": "command",
          "statusMessage": "Checking the merge bead for this branch...",
          "command": ".claude/hooks/beads/scripts/pr-merge-bead-guard.py"
        },
        {
          "type": "command",
          "statusMessage": "Staging beads JSONL for commit...",
          "command": ".claude/hooks/beads/scripts/beads-sync-stage.py"
        }
      ],
      "_apm_source": "beads"
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Checking orchestrator claim policy...",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/hooks/orchestrate/scripts/orchestrator-claim-deny.py",
          "timeout": 30
        }
      ],
      "_apm_source": "orchestrate"
    },
    {
      "matcher": "Agent|SendMessage",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Checking claim-holder activation sequence...",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/hooks/orchestrate/scripts/orchestrator-activation-guard.py",
          "timeout": 30
        }
      ],
      "_apm_source": "orchestrate"
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": ".claude/hooks/release-please/scripts/release-please-guard.py",
          "timeout": 10
        }
      ],
      "_apm_source": "release-please"
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": ".claude/hooks/speckit-conductor/scripts/speckit-pr-title.py"
        }
      ],
      "_apm_source": "speckit-conductor"
    },
    {
      "matcher": "Write|Edit|MultiEdit|Bash|Skill",
      "hooks": [
        {
          "type": "command",
          "command": ".claude/hooks/speckit-conductor/scripts/speckit-tasks-guard.py",
          "timeout": 10
        }
      ],
      "_apm_source": "speckit-conductor"
    },
    {
      "matcher": "apply_patch|Write|Edit|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": ".claude/hooks/adr-as-beads/scripts/adr-write-guard.py",
          "timeout": 10
        }
      ],
      "_apm_source": "adr-as-beads"
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/hooks/hooks-worktrunk/scripts/worktrunk-guard.py",
          "timeout": 10
        }
      ],
      "_apm_source": "hooks-worktrunk"
    },
    {
      "matcher": "Agent",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/hooks/hooks-worktrunk/scripts/worktrunk-agent-guard.py",
          "timeout": 10
        }
      ],
      "_apm_source": "hooks-worktrunk"
    },
    {
      "matcher": "Agent|SendMessage",
      "hooks": [
        {
          "type": "command",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/hooks/worktrunk-writer/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py hook",
          "timeout": 10
        }
      ],
      "_apm_source": "worktrunk-writer"
    },
    {
      "matcher": "Bash|Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/hooks/worktrunk-writer/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py hook",
          "timeout": 10
        }
      ],
      "_apm_source": "worktrunk-writer"
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Checking draft PR policy...",
          "command": "python3 .claude/hooks/steering-git-workflow/scripts/pr-create-guard.py",
          "timeout": 10
        }
      ],
      "_apm_source": "steering-git-workflow"
    }
  ],
  "SubagentStart": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Injecting beads work contract...",
          "command": ".claude/hooks/beads/scripts/beads-subagent-reminder.py"
        }
      ],
      "_apm_source": "beads"
    },
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Injecting bead-as-brief claim contract...",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/hooks/orchestrate/scripts/contract-start.py",
          "timeout": 30
        }
      ],
      "_apm_source": "orchestrate"
    },
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": ".claude/hooks/steering-pragmatic/scripts/inject-working-style.py",
          "timeout": 5
        }
      ],
      "_apm_source": "steering-pragmatic"
    },
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": ".claude/hooks/code-intelligence/scripts/subagent-context-inject.py",
          "timeout": 5
        }
      ],
      "_apm_source": "code-intelligence"
    },
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/hooks/worktrunk-writer/.apm/skills/worktrunk-writer/scripts/context-handshake.py",
          "timeout": 10
        }
      ],
      "_apm_source": "worktrunk-writer"
    }
  ],
  "SessionStart": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Syncing beads (Dolt pull, JSONL fallback)...",
          "command": ".claude/hooks/beads/scripts/beads-sync-session.py",
          "timeout": 90
        }
      ],
      "_apm_source": "beads"
    },
    {
      "matcher": "startup",
      "hooks": [
        {
          "type": "command",
          "async": true,
          "command": ".claude/hooks/hooks-worktrunk/scripts/worktrunk-sweep.py",
          "timeout": 60
        }
      ],
      "_apm_source": "hooks-worktrunk"
    }
  ],
  "SessionEnd": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Publishing beads state...",
          "command": ".claude/hooks/beads/scripts/beads-sync-push.py",
          "timeout": 60
        }
      ],
      "_apm_source": "beads"
    }
  ],
  "PostToolUse": [
    {
      "matcher": "apply_patch|Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/hooks/hooks-quality/scripts/quality-edit-advisory.py",
          "timeout": 3
        }
      ],
      "_apm_source": "hooks-quality"
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Activating orchestrate run enforcement...",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/hooks/orchestrate/scripts/orchestrator-run-activate.py",
          "timeout": 30
        }
      ],
      "_apm_source": "orchestrate"
    }
  ],
  "SubagentStop": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Evaluating bead contract...",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && RULES_DIR=\"$(dirname \".claude/hooks/orchestrate/.apm/rules/generic.rules.json\")\" python3 .claude/hooks/orchestrate/scripts/rules-eval.py",
          "timeout": 45
        }
      ],
      "_apm_source": "orchestrate"
    },
    {
      "matcher": "domain-specialist|domain-specialist-high|shepherd|reviewer|researcher|advisor|scribe",
      "hooks": [
        {
          "type": "command",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .claude/hooks/worktrunk-writer/.apm/skills/worktrunk-writer/scripts/worktrunk-writer.py subagent-exit",
          "timeout": 10
        }
      ],
      "_apm_source": "worktrunk-writer"
    }
  ],
  "WorktreeCreate": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": ".claude/hooks/hooks-worktrunk/scripts/worktrunk-lifecycle-provider.sh",
          "timeout": 60
        }
      ],
      "_apm_source": "hooks-worktrunk"
    }
  ],
  "WorktreeRemove": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": ".claude/hooks/hooks-worktrunk/scripts/worktrunk-lifecycle-provider.sh",
          "timeout": 60
        }
      ],
      "_apm_source": "hooks-worktrunk"
    }
  ]
}
